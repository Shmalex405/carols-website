---
/**
 * Decorative pink pumpkin for October (Breast Cancer Awareness Month).
 * `ribbon` paints a small white awareness ribbon on its front.
 */
interface Props {
  shade?: 'rose' | 'blush' | 'berry';
  ribbon?: boolean;
  class?: string;
}
const { shade = 'rose', ribbon = false, class: cls = 'w-16' } = Astro.props;

const shades = {
  rose: { outer: '#c76a85', mid: '#dc8aa1', light: '#eaa6b8' },
  blush: { outer: '#dc93a7', mid: '#ebb0c0', light: '#f5cad5' },
  berry: { outer: '#a84d69', mid: '#c2677f', light: '#d78699' },
};
const c = shades[shade];
---

<svg class={cls} viewBox="0 0 64 56" aria-hidden="true">
  <!-- vine curl + stem + leaf -->
  <path d="M29.5 14.5c-3.5-2.5-8-1-7.5 2.2.4 2.4 3.6 2.2 3.4.2" fill="none" stroke="#5e7c6a" stroke-width="1.3" stroke-linecap="round" />
  <path d="M29.5 18c0-5 1-9 4-12l3 1.5c-2.5 3-2.7 6.5-2 10.5z" fill="#5e7c6a" />
  <path d="M34.5 13c3.5-5 10.5-6 14.5-3.5-3 4.5-9.5 6-14.5 3.5z" fill="#7f9a86" />
  <path d="M35.5 12.6c3.5-1.4 7.5-2.2 11.5-2.6" fill="none" stroke="#5e7c6a" stroke-width=".8" stroke-linecap="round" />
  <!-- ribs, back to front -->
  <ellipse cx="19" cy="36" rx="15" ry="17" fill={c.outer} />
  <ellipse cx="45" cy="36" rx="15" ry="17" fill={c.outer} />
  <ellipse cx="25" cy="35.5" rx="12" ry="18.5" fill={c.mid} stroke={c.outer} stroke-width=".8" />
  <ellipse cx="39" cy="35.5" rx="12" ry="18.5" fill={c.mid} stroke={c.outer} stroke-width=".8" />
  <ellipse cx="32" cy="35" rx="9.5" ry="19.5" fill={c.light} stroke={c.outer} stroke-width=".8" />
  <ellipse cx="28.4" cy="25" rx="1.7" ry="5" fill="#fff" opacity=".35" transform="rotate(12 28.4 25)" />
  {ribbon && (
    <path
      d="M17 21.5 10.2 10.8C8.8 8.6 8.4 7.4 8.4 6.2a3.6 3.6 0 0 1 7.2 0c0 1.2-.4 2.4-1.8 4.6L7 21.5"
      transform="translate(24.8 29.2) scale(.6)"
      fill="none"
      stroke="#fff"
      stroke-width="2.4"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  )}
</svg>
